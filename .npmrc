node-options="--max-old-space-size=8192"
legacy-peer-deps=true
# install-links=true is intentionally OFF.
# With it on, `npm install` of a `file:` dependency hardlinks package.json only
# and skips the package's `files` list (dist/, etc.). The control-module's
# `files: ["dist"]` then lands in node_modules as a bare package.json, which
# makes `tsc` fail with TS2307 on every subpath import. Keep this off until we
# move the workspace dependency to a real registry or commit `dist/`.
install-links=false
