{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synthex.social/schemas/marketing-intelligence/outputs.json",
  "title": "Agentic Marketing Intelligence — run outputs",
  "type": "object",
  "required": ["run_id", "generated_at", "data_status_summary", "backlog"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_status_summary": {
      "type": "object",
      "required": ["verified", "partial", "data_required"],
      "properties": {
        "verified": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "data_required": { "type": "integer", "minimum": 0 }
      }
    },
    "backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "project", "confidence_adjusted_action", "data_status"],
        "properties": {
          "url": { "type": "string" },
          "project": { "type": "string" },
          "recommended_action": { "type": "string" },
          "claim_refs": { "type": "array", "items": { "type": "string" } },
          "impact_score": { "type": "number" },
          "confidence_score": { "type": "number" },
          "risk_score": { "type": "number" },
          "confidence_adjusted_action": { "type": "number" },
          "data_status": { "type": "string", "enum": ["VERIFIED", "PARTIAL", "DATA_REQUIRED", "HYPOTHESIS_FOR_TESTING"] },
          "blocked_reason": { "type": ["string", "null"] },
          "validation_method": { "type": "string" },
          "rollback_note": { "type": "string" }
        }
      }
    },
    "data_required_items": { "type": "array", "items": { "type": "string" } },
    "human_approval_required": { "type": "array", "items": { "type": "object" } }
  }
}
