{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synthex.social/schemas/marketing-intelligence/source-map.json",
  "title": "Obsidian / external source map",
  "type": "object",
  "required": ["generated_at", "vault_path", "note_count_total", "folders", "youtube_channels_found", "data_required"],
  "additionalProperties": true,
  "properties": {
    "generated_at": { "type": "string", "format": "date" },
    "generated_by": { "type": "string" },
    "vault_path": { "type": "string" },
    "vault_type": { "type": "string" },
    "scan_method": { "type": "string" },
    "note_count_total": { "type": "integer", "minimum": 0 },
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "purpose": { "type": "string" },
          "seo_relevance": { "type": "string" }
        }
      }
    },
    "seo_term_coverage": { "type": "object" },
    "youtube_channels_found": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "source_note": { "type": "string" }
        }
      }
    },
    "neil_patel_references_found": { "type": "array" },
    "gsc_analytics_semrush_exports_found": { "type": "array" },
    "load_bearing_infrastructure": { "type": "array" },
    "data_required": { "type": "array", "items": { "type": "string" } }
  }
}
