CREATE TEMP TABLE IF NOT EXISTS synthex_dependency_tables (
  table_name TEXT PRIMARY KEY
);

TRUNCATE synthex_dependency_tables;

INSERT INTO synthex_dependency_tables (table_name)
VALUES
  ('profiles'),
  ('personas'),
  ('user_roles');

SELECT
  'expected_missing_table_status' AS check_name,
  e.table_name,
  e.source_file,
  CASE WHEN t.table_name IS NULL THEN 'missing' ELSE 'already_present' END AS live_status
FROM synthex_expected_missing_tables e
LEFT JOIN information_schema.tables t
  ON t.table_schema = 'public'
 AND t.table_type = 'BASE TABLE'
 AND t.table_name = e.table_name
ORDER BY e.table_name;

SELECT
  'dependency_table_status' AS check_name,
  d.table_name,
  CASE WHEN t.table_name IS NULL THEN 'missing_dependency' ELSE 'present' END AS live_status
FROM synthex_dependency_tables d
LEFT JOIN information_schema.tables t
  ON t.table_schema = 'public'
 AND t.table_type = 'BASE TABLE'
 AND t.table_name = d.table_name
ORDER BY d.table_name;

SELECT
  'ledger_status' AS check_name,
  to_regclass('public._prisma_migrations') AS prisma_ledger,
  to_regclass('public.schema_migrations') AS custom_ledger;

SELECT
  'public_table_count' AS check_name,
  count(*)::int AS public_base_tables
FROM information_schema.tables
WHERE table_schema = 'public'
  AND table_type = 'BASE TABLE';
