{
  "id": "screen-through",
  "name": "Screen Through",
  "signals": "Confident product: no cards, no intro, the camera moves through the real screen and holds on the point.",
  "fits": ["software", "platform"],
  "palette": {
    "paper": "#ffffff",
    "pattern": "none",
    "patternInk": "ink",
    "overlay": "none"
  },
  "type": {
