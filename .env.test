# .env.test — SYNTHEX test environment variables
# These are NON-SECRET placeholder values used exclusively by Jest.
# Real secrets must NEVER be committed here.

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_SECRET=test-nextauth-secret-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# ── Redis / Upstash ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=test-redis-token

# ── AI providers ─────────────────────────────────────────────
OPENROUTER_API_KEY=test-openrouter-key
OPENAI_API_KEY=test-openai-key
ANTHROPIC_API_KEY=test-anthropic-key
GOOGLE_AI_API_KEY=test-google-ai-key

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=test-cron-secret
NODE_ENV=test
