{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synthex.social/schemas/marketing-intelligence/inputs.json",
  "title": "Agentic Marketing Intelligence — run inputs",
  "type": "object",
  "required": ["run_id", "scope_projects"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "requested_at": { "type": "string", "format": "date-time" },
    "scope_projects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Unite-Group",
          "Synthex",
          "RestoreAssist",
          "CARSI",
          "Disaster-Recovery",
          "NRPG",
          "CCW",
          "Local-Lift",
          "AI_Guided_SaaS"
        ]
      },
      "minItems": 1
    },
    "obsidian_vault_path": {
      "type": "string",
      "default": "/Users/phillmcgurk/2nd-brain"
    },
    "youtube_channels": {
      "type": "array",
      "description": "Channel URLs to analyse. Empty => YouTube analysis is DATA_REQUIRED.",
      "items": { "type": "string", "format": "uri" }
    },
    "data_sources_enabled": {
      "type": "object",
      "description": "Which live integrations are wired. False => the corresponding scores are DATA_REQUIRED.",
      "properties": {
        "gsc": { "type": "boolean", "default": false },
        "google_analytics": { "type": "boolean", "default": false },
        "semrush": { "type": "boolean", "default": false },
        "internal_crawl": { "type": "boolean", "default": false },
        "youtube_data_api": { "type": "boolean", "default": false }
      }
    },
    "weights_override": {
      "type": "object",
      "description": "Tunable weights; overriding is a logged decision."
    },
    "approval_mode": {
      "type": "string",
      "enum": ["prepare_only", "auto_low_risk", "auto_all"],
      "default": "prepare_only",
      "description": "prepare_only = never publish; auto_low_risk = publish only risk<0.7 & confidence>=INFERRED; auto_all is disallowed for live sites."
    }
  }
}
