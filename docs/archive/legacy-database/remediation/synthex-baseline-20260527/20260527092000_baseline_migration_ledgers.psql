INSERT INTO public._prisma_migrations (
  id,
  checksum,
  finished_at,
  migration_name,
  logs,
  rolled_back_at,
  started_at,
  applied_steps_count
)
SELECT
  substr(md5(migration_name), 1, 32),
  checksum,
  now(),
  migration_name,
  'Baseline-stamped from populated production schema after Synthex remediation audit.',
  NULL,
  now(),
  1
FROM prisma_baseline b
WHERE NOT EXISTS (
  SELECT 1
  FROM public._prisma_migrations m
  WHERE m.migration_name = b.migration_name
);

