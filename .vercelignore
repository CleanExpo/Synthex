scripts/*
!scripts/validate-schema.ts
# build:vercel runs `sh scripts/build-with-migrations.sh`, which on production
# also runs `node scripts/check-schema-drift.mjs`. Both MUST survive the deploy
# upload or the build dies at exit 127 (sh: ...: No such file or directory),
# which has been failing every production + preview deploy since PR #375.
!scripts/build-with-migrations.sh
!scripts/check-schema-drift.mjs
